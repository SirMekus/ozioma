{
    "name": "sirmekus/ozioma",
    "description": "Ozioma (Igbo for \"good news\" or \"message\") logs the outgoing HTTP requests your Laravel application makes with the Http client, but only to the URLs you allow, masking sensitive headers and body fields before anything is written.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ozioma", "laravel", "http", "logging", "guzzle", "middleware"],
    "authors": [
        {
            "name": "SirMekus (Emmy Boy)",
            "email": "mekus600@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/log": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Emmy\\Ozioma\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emmy\\Ozioma\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emmy\\Ozioma\\Provider\\OziomaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
